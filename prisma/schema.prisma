  supersededAt         DateTime?
  createdByUserId      String
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt
  organization         Organization                         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client               Client                               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template             ClientDocumentTemplate?              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  representative       ClientRepresentative?                @relation(fields: [representativeId], references: [id], onDelete: Restrict)
  obligationDocument   ClientDocument?                      @relation("DocumentRequestObligation", fields: [obligationDocumentId], references: [id], onDelete: Restrict)
  fulfilledDocument    ClientDocument?                      @relation("DocumentRequestFulfillment", fields: [fulfilledDocumentId], references: [id], onDelete: Restrict)
  createdBy            User                                 @relation("ClientDocumentRequestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  supersedes           ClientDocumentRequest?               @relation("ClientDocumentRequestSupersession", fields: [supersedesRequestId], references: [id], onDelete: Restrict)
  supersededBy         ClientDocumentRequest?               @relation("ClientDocumentRequestSupersession")

  @@index([organizationId, clientId, status, dueAt], map: "document_request_org_client_status_due_idx")
  @@index([organizationId, obligationDocumentId, status], map: "document_request_org_obligation_status_idx")
  @@index([organizationId, fulfilledDocumentId], map: "document_request_org_fulfillment_idx")
}

model RoiAuthorization {
  id               String          @id @default(cuid())
  organizationId   String
  clientId         String
  documentId       String?         @unique
  direction        RoiDirection
  recipientName    String
  relationshipRole String?
  addressJson      Json?
  phone            String?
  faxEmail         String?
  categories       Json
  limitations      String?
  purposes         Json
  effectiveDate    DateTime        @db.Date
  expirationDate   DateTime        @db.Date
  expirationEvent  String?
  status           RoiStatus       @default(DRAFT)
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  document         ClientDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, status, expirationDate])
}

model SignatureEnvelope {
  id                 String                  @id @default(cuid())
  organizationId     String
  clientId           String
  documentId         String                  @unique
  mode               SignatureMode
  provider           String
  providerEnvelopeId String?
  status             SignatureEnvelopeStatus @default(DRAFT)
  frozenPdf          Bytes?
  frozenDocumentHash String?
  finalDocumentHash  String?
  consentVersion     String                  @default("native-esign-consent-v1")
  evidenceJson       Json?
  evidencePdf        Bytes?
  sentAt             DateTime?
  completedAt        DateTime?
  voidedAt           DateTime?
  voidReason         String?
  currentRenditionId String?                 @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  document           ClientDocument          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  client             Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  signers            SignatureSigner[]
  invitations        SignatureInvitation[]
  renditions         SignatureRendition[]    @relation("EnvelopeRenditions")
  currentRendition   SignatureRendition?     @relation("CurrentEnvelopeRendition", fields: [currentRenditionId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, status])
}

model SignatureSigner {
  id                     String                    @id @default(cuid())
  envelopeId             String
  role                   String
  name                   String
  email                  String?
  required               Boolean                   @default(true)
  status                 SignatureSignerStatus     @default(PENDING)
  providerSignerId       String?
  sentAt                 DateTime?
  viewedAt               DateTime?
  signedAt               DateTime?
  signatureMethod        SignatureMethod?
  adoptedName            String?
  signatureData          Bytes?
  consentVersion         String?
  consentedAt            DateTime?
  verificationMethod     SignerVerificationMethod?
  facilitatorUserId      String?
  reviewedRenditionId    String?
  reviewedRenditionHash  String?
  resultingRenditionId   String?
  resultingRenditionHash String?
  auditJson              Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  envelope               SignatureEnvelope         @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  invitations            SignatureInvitation[]

  @@index([envelopeId, status])
}

model SignatureInvitation {
  id                           String                            @id @default(cuid())
  organizationId               String
  envelopeId                   String
  signerId                     String
  tokenDigest                  String                            @unique
  status                       SignatureInvitationStatus         @default(ACTIVE)
  deliveryStatus               SignatureInvitationDeliveryStatus @default(PENDING)
  deliveryAttempts             Int                               @default(0)
  deliveryAttemptedAt          DateTime?
  deliveryErrorCode            String?
  providerMessageId            String?
  expiresAt                    DateTime
  providerAcceptedAt           DateTime?
  deliveredAt                  DateTime?
  usedAt                       DateTime?
  revokedAt                    DateTime?
  replacedById                 String?                           @unique
  reviewedRenditionId          String?
  reviewedRenditionHash        String?
  reviewedAt                   DateTime?
  pendingSignatureMethod       SignatureMethod?
  pendingAdoptedName           String?
  pendingSignatureData         Bytes?
  pendingConsentVersion        String?
  pendingConsentedAt           DateTime?
  pendingReviewedRenditionId   String?
  pendingReviewedRenditionHash String?
  createdAt                    DateTime                          @default(now())
  envelope                     SignatureEnvelope                 @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  signer                       SignatureSigner                   @relation(fields: [signerId], references: [id], onDelete: Restrict)
  replacedBy                   SignatureInvitation?              @relation("InvitationReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces                     SignatureInvitation?              @relation("InvitationReplacement")

  @@index([organizationId, envelopeId, signerId, status])
  @@index([organizationId, deliveryStatus, deliveryAttemptedAt])
  @@index([expiresAt, status])
}

model SignatureRendition {
  id                    String                    @id @default(cuid())
  envelopeId            String
  sequence              Int
  previousRenditionId   String?
  signerId              String?
  pdf                   Bytes
  renditionHash         String
  sourceContentHash     String
  reviewedRenditionId   String?
  reviewedRenditionHash String?
  verificationMethod    SignerVerificationMethod?
  acceptedAt            DateTime?
  isFinal               Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  envelope              SignatureEnvelope         @relation("EnvelopeRenditions", fields: [envelopeId], references: [id], onDelete: Restrict)
  currentForEnvelope    SignatureEnvelope?        @relation("CurrentEnvelopeRendition")
  previous              SignatureRendition?       @relation("RenditionLineage", fields: [previousRenditionId], references: [id], onDelete: Restrict)
  next                  SignatureRendition[]      @relation("RenditionLineage")

  @@unique([envelopeId, sequence])
  @@unique([envelopeId, signerId])
  @@index([previousRenditionId])
  @@index([envelopeId, isFinal])
}
