model EmployeeOnboardingStep {
  id                   String                   @id @default(cuid())
  employeeOnboardingId String
  stepDefinitionId     String
  status               OnboardingStepStatus     @default(PENDING)
  dueAt                DateTime?
  completedAt          DateTime?
  completedByUserId    String?
  sourceResourceType   String?
  sourceResourceId     String?
  explanationJson      Json?
  administrativeNote   String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  employeeOnboarding   EmployeeOnboarding       @relation(fields: [employeeOnboardingId], references: [id], onDelete: Restrict)
  stepDefinition       OnboardingStepDefinition @relation(fields: [stepDefinitionId], references: [id], onDelete: Restrict)
  completedBy          User?                    @relation("OnboardingStepCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeOnboardingId, stepDefinitionId])
}

model Policy {
  id                        String          @id @default(cuid())
  organizationId            String
  code                      String
  title                     String
  description               String?
  status                    PolicyStatus    @default(ACTIVE)
  requiresAcknowledgment    Boolean         @default(false)
  reacknowledgeOnNewVersion Boolean         @default(false)
  blockingScope             BlockingScope?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions                  PolicyVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model PolicyVersion {
  id              String              @id @default(cuid())
  policyId        String
  versionNumber   Int
  status          PolicyVersionStatus @default(DRAFT)
  effectiveFrom   DateTime            @db.Date
  effectiveUntil  DateTime?           @db.Date
  publishedAt     DateTime?
  body            String
  contentHash     String
  createdByUserId String
  createdAt       DateTime            @default(now())
  policy          Policy              @relation(fields: [policyId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("PolicyVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments     PolicyAssignment[]

  @@unique([policyId, versionNumber])
  @@index([status, effectiveFrom, effectiveUntil])
}

model PolicyAssignment {
  id                String                 @id @default(cuid())
  fingerprint       String                 @unique
  organizationId    String
  employeeId        String
  policyVersionId   String
  assignedAt        DateTime               @default(now())
  dueAt             DateTime?
  assignedByUserId  String?
  sourceType        PolicyAssignmentSource
  sourceReferenceId String?
  status            PolicyAssignmentStatus @default(PENDING)
  acknowledgedAt    DateTime?
  attestationId     String?                @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee          Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  policyVersion     PolicyVersion          @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  assignedBy        User?                  @relation("PolicyAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  attestation       Attestation?           @relation(fields: [attestationId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, status])
}

model WorkReadinessEvaluation {
  id                String               @id @default(cuid())
  organizationId    String
  employeeId        String
  evaluatedAt       DateTime
  evaluationTrigger WorkReadinessTrigger
  resultJson        Json
  engineVersion     String
  createdAt         DateTime             @default(now())
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, evaluatedAt])
}

model LearningObjective {
  id                 String                         @id @default(cuid())
  courseVersionId    String
  code               String
  title              String
  description        String?
  required           Boolean                        @default(true)
  assessmentRequired Boolean                        @default(true)
  criticalSafety     Boolean                        @default(false)
  createdAt          DateTime                       @default(now())
  courseVersion      TrainingCourseVersion          @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  requirements       LearningObjectiveRequirement[]
  modules            LearningObjectiveModule[]
  contentItems       LearningObjectiveContent[]
  questions          LearningObjectiveQuestion[]

  @@unique([courseVersionId, code])
  @@index([code])
}

model LearningObjectiveRequirement {
  id                   String                       @id @default(cuid())
  learningObjectiveId  String
  requirementVersionId String
  createdAt            DateTime                     @default(now())
  learningObjective    LearningObjective            @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)
  requirementVersion   ComplianceRequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)

  @@unique([learningObjectiveId, requirementVersionId])
}

model LearningObjectiveModule {
  id                  String            @id @default(cuid())
  learningObjectiveId String
  moduleId            String
  createdAt           DateTime          @default(now())
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)
  module              TrainingModule    @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([learningObjectiveId, moduleId])
}

model LearningObjectiveContent {
  id                  String              @id @default(cuid())
  learningObjectiveId String
  contentItemId       String
  createdAt           DateTime            @default(now())
  learningObjective   LearningObjective   @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)
  contentItem         TrainingContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)

  @@unique([learningObjectiveId, contentItemId])
}

model LearningObjectiveQuestion {
  id                  String             @id @default(cuid())
  learningObjectiveId String
  questionId          String
  createdAt           DateTime           @default(now())
  learningObjective   LearningObjective  @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)
  question            AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([learningObjectiveId, questionId])
}

model TrainingModuleSubjectArea {
  id              String         @id @default(cuid())
  moduleId        String
  subjectAreaCode String
  subjectAreaName String
  minutes         Int
  createdAt       DateTime       @default(now())
  module          TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([moduleId, subjectAreaCode])
  @@index([subjectAreaCode])
}

model QuestionBank {
  id              String                @id @default(cuid())
  courseVersionId String
  code            String
  name            String
  createdAt       DateTime              @default(now())
  courseVersion   TrainingCourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  versions        QuestionBankVersion[]

  @@unique([courseVersionId, code])
}

model QuestionBankVersion {
  id             String                      @id @default(cuid())
  questionBankId String
  versionNumber  Int
  status         TrainingCourseVersionStatus @default(DRAFT)
  contentHash    String
  createdAt      DateTime                    @default(now())
  questionBank   QuestionBank                @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  assessments    Assessment[]
  questions      AssessmentQuestion[]

  @@unique([questionBankId, versionNumber])
}
