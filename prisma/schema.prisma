model Brand {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  status           RecordStatus   @default(ACTIVE)
  logoObjectKey    String?
  faviconObjectKey String?
  primaryDomain    String?
  supportEmail     String?
  themeConfigJson  Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organizations    Organization[]
}

model Organization {
  id                        String                                   @id @default(cuid())
  brandId                   String?
  legalName                 String
  displayName               String
  slug                      String                                   @unique
  status                    OrganizationStatus                       @default(ACTIVE)
  timezone                  String                                   @default("America/Chicago")
  defaultLanguage           String?
  phone                     String?
  email                     String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?
  createdAt                 DateTime                                 @default(now())
  updatedAt                 DateTime                                 @updatedAt
  brand                     Brand?                                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  licenses                  OrganizationLicense[]
  programs                  Program[]
  locations                 Location[]
  memberships               OrganizationMembership[]
  roles                     RoleDefinition[]
  employees                 Employee[]
  serviceEvents             EmployeeServiceEvent[]
  complianceEvaluationRuns  ComplianceEvaluationRun[]
  complianceInstances       ComplianceInstance[]
  trainingCourses           TrainingCourse[]
  trainingAssignments       TrainingAssignment[]
  trainingCompletions       TrainingCompletion[]
  assessmentAttempts        AssessmentAttempt[]
  trainingAssignmentEvents  TrainingAssignmentEvent[]
  competencyDefinitions     CompetencyDefinition[]
  skillChecklists           SkillChecklist[]
  competencyAssessments     CompetencyAssessment[]
  professionalCredentials   ProfessionalCredential[]
  externalTrainingRecords   ExternalTrainingRecord[]
  equivalencyDecisions      RequirementEquivalencyDecision[]
  attestations              Attestation[]
  evidenceCorrections       EvidenceCorrection[]
  certificates              Certificate[]
  onboardingTemplates       OnboardingTemplate[]
  employeeOnboardings       EmployeeOnboarding[]
  policies                  Policy[]
  policyAssignments         PolicyAssignment[]
  workReadinessEvaluations  WorkReadinessEvaluation[]
  medicationPathways        MedicationQualificationPathway[]
  clinicalApprovals         ClinicalCurriculumApproval[]
  medicationQualifications  MedicationQualification[]
  medicationInstructions    PersonSpecificMedicationInstruction[]
  medicationAuthorizations  MedicationAuthorizationEvidence[]
  clinicalEvents            ClinicalGovernanceEvent[]
  serviceAssignments        ServiceAssignment[]
  assignmentRules           ServiceAssignmentRequirementRule[]
  assignmentEvaluations     ServiceAssignmentEligibilityEvaluation[]
  assignmentEvents          ServiceAssignmentEvent[]
  complianceIssues          ComplianceIssue[]
  complianceIssueEvents     ComplianceIssueEvent[]
  auditPackages             AuditPackage[]
  auditEvents               AuditEvent[]
  employeePortalInvitations EmployeePortalInvitation[]
  notifications             Notification[]
  notificationDeliveries    NotificationDelivery[]
  notificationPreferences   NotificationPreference[]
  clients                   Client[]
  professionalContacts      ProfessionalContact[]
  clientDocumentTemplates   ClientDocumentTemplate[]
  clientDocumentRequests    ClientDocumentRequest[]
  auditAccessSessions       AuditAccessSession[]
  clientImportSessions      ClientImportSession[]
  clientImportDocuments     ClientImportDocument[]
  clientImportProposals     ClientImportProposal[]
}

model OrganizationLicense {
  id               String        @id @default(cuid())
  organizationId   String
  licenseType      LicenseType
  licenseNumber    String?
  licenseStatus    LicenseStatus @default(PENDING)
  effectiveDate    DateTime?     @db.Date
  expirationDate   DateTime?     @db.Date
  issuingAuthority String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Program {
  id                 String                             @id @default(cuid())
  organizationId     String
  name               String
  code               String?
  programType        String?
  status             RecordStatus                       @default(ACTIVE)
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations          Location[]
  serviceEvents      EmployeeServiceEvent[]
  serviceAssignments ServiceAssignment[]
  assignmentRules    ServiceAssignmentRequirementRule[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Location {
  id                 String                             @id @default(cuid())
  organizationId     String
  programId          String?
  name               String
  locationType       String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  status             RecordStatus                       @default(ACTIVE)
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program            Program?                           @relation(fields: [programId], references: [id], onDelete: SetNull)
  serviceEvents      EmployeeServiceEvent[]
  serviceAssignments ServiceAssignment[]
  assignmentRules    ServiceAssignmentRequirementRule[]

  @@index([organizationId, status])
  @@index([organizationId, programId])
}

model User {
  id                            String                                   @id @default(cuid())
  authProviderUserId            String?                                  @unique
  email                         String?                                  @unique
  phone                         String?
  status                        UserStatus                               @default(INVITED)
  lastLoginAt                   DateTime?
  createdAt                     DateTime                                 @default(now())
  updatedAt                     DateTime                                 @updatedAt
  memberships                   OrganizationMembership[]
  employees                     Employee[]
  recordedEvents                EmployeeServiceEvent[]                   @relation("RecordedBy")
  verifiedRegulationVersions    RegulationVersion[]                      @relation("RegulationVerifiedBy")
  assignedTraining              TrainingAssignment[]                     @relation("TrainingAssignedBy")
  cancelledTraining             TrainingAssignment[]                     @relation("TrainingCancelledBy")
  trainingAssignmentEvents      TrainingAssignmentEvent[]
  trainingAcknowledgments       TrainingAcknowledgment[]                 @relation("TrainingAcknowledgedBy")
  competencyAssessments         CompetencyAssessment[]                   @relation("CompetencyAssessorUser")
  credentials                   ProfessionalCredential[]                 @relation("CredentialUser")
  verifiedCredentials           ProfessionalCredential[]                 @relation("CredentialVerifiedBy")
  reviewedExternalTraining      ExternalTrainingRecord[]                 @relation("ExternalTrainingReviewedBy")
  equivalencyDecisions          RequirementEquivalencyDecision[]         @relation("EquivalencyReviewer")
  attestations                  Attestation[]                            @relation("AttestationSigner")
  evidenceCorrections           EvidenceCorrection[]                     @relation("EvidenceCorrectedBy")
  issuedCertificates            Certificate[]                            @relation("CertificateIssuedBy")
  createdOnboardings            EmployeeOnboarding[]                     @relation("OnboardingCreatedBy")
  completedOnboardingSteps      EmployeeOnboardingStep[]                 @relation("OnboardingStepCompletedBy")
  createdPolicyVersions         PolicyVersion[]                          @relation("PolicyVersionCreatedBy")
  assignedPolicies              PolicyAssignment[]                       @relation("PolicyAssignedBy")
  clinicalApprovals             ClinicalCurriculumApproval[]             @relation("ClinicalCurriculumReviewer")
  medicationQualifications      MedicationQualification[]                @relation("MedicationQualificationReviewer")
  medicationInstructions        PersonSpecificMedicationInstruction[]    @relation("MedicationInstructionReviewer")
  medicationAuthorizations      MedicationAuthorizationEvidence[]        @relation("MedicationAuthorizationRecorder")
  clinicalEvents                ClinicalGovernanceEvent[]                @relation("ClinicalGovernanceActor")
  createdServiceAssignments     ServiceAssignment[]                      @relation("ServiceAssignmentCreator")
  cancelledServiceAssignments   ServiceAssignment[]                      @relation("ServiceAssignmentCanceller")
  assignmentEvaluations         ServiceAssignmentEligibilityEvaluation[] @relation("AssignmentEvaluationActor")
  assignmentEvents              ServiceAssignmentEvent[]                 @relation("AssignmentEventActor")
  managedComplianceIssues       ComplianceIssue[]                        @relation("ComplianceIssueWorkflowActor")
  complianceIssueEvents         ComplianceIssueEvent[]                   @relation("ComplianceIssueEventActor")
  requestedAuditPackages        AuditPackage[]                           @relation("AuditPackageRequester")
  auditEvents                   AuditEvent[]                             @relation("AuditEventActor")
  sentEmployeeInvitations       EmployeePortalInvitation[]               @relation("EmployeePortalInvitationSender")
  acceptedEmployeeInvitations   EmployeePortalInvitation[]               @relation("EmployeePortalInvitationAccepter")
  notifications                 Notification[]                           @relation("NotificationRecipient")
  notificationPreferences       NotificationPreference[]
  createdClients                Client[]                                 @relation("ClientCreatedBy")
  completedClientIntakes        ClientIntake[]                           @relation("ClientIntakeCompletedBy")
  generatedClientDocuments      ClientDocument[]                         @relation("ClientDocumentGeneratedBy")
  createdClientDocumentRequests ClientDocumentRequest[]                  @relation("ClientDocumentRequestCreator")
  inspectorAuditSessions        AuditAccessSession[]                     @relation("AuditAccessInspector")
  createdAuditAccessSessions    AuditAccessSession[]                     @relation("AuditAccessCreator")
  revokedAuditAccessSessions    AuditAccessSession[]                     @relation("AuditAccessRevoker")
  uploadedClientImports         ClientImportSession[]                    @relation("ClientImportUploader")
  reviewedClientImportProposals ClientImportProposal[]                   @relation("ClientImportProposalReviewer")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  endedAt        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RoleDefinition {
  id                 String           @id @default(cuid())
  organizationId     String?
  code               String
  name               String
  description        String?
  scope              RoleScope
  isPlatformStandard Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions        RolePermission[]
  memberships        MembershipRole[]
  employeeRoles      EmployeeRole[]

  @@unique([organizationId, code])
  @@index([code, isPlatformStandard])
}

model RolePermission {
  id               String         @id @default(cuid())
  roleDefinitionId String
  permissionId     String
  createdAt        DateTime       @default(now())
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleDefinitionId, permissionId])
}

model MembershipRole {
  id               String                 @id @default(cuid())
  membershipId     String
  roleDefinitionId String
  createdAt        DateTime               @default(now())
  membership       OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  roleDefinition   RoleDefinition         @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleDefinitionId])
}

model Employee {
  id                       String                                   @id @default(cuid())
  organizationId           String
  userId                   String?
  employeeNumber           String?
  firstName                String
  middleName               String?
  lastName                 String
  preferredName            String?
  email                    String?
  phone                    String?
  hireDate                 DateTime?                                @db.Date
  terminationDate          DateTime?                                @db.Date
  employmentStatus         EmploymentStatus                         @default(PENDING)
  jobTitle                 String?
  employmentType           EmploymentType?
  createdAt                DateTime                                 @default(now())
  updatedAt                DateTime                                 @updatedAt
  organization             Organization                             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                     User?                                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  roles                    EmployeeRole[]
  duties                   EmployeeDuty[]
  serviceEvents            EmployeeServiceEvent[]
  complianceInstances      ComplianceInstance[]
  trainingAssignments      TrainingAssignment[]
  trainingCompletions      TrainingCompletion[]
  assessmentAttempts       AssessmentAttempt[]
  trainingAcknowledgments  TrainingAcknowledgment[]
  competencyAssessments    CompetencyAssessment[]                   @relation("CompetencySubject")
  assessedCompetencies     CompetencyAssessment[]                   @relation("CompetencyAssessorEmployee")
  professionalCredentials  ProfessionalCredential[]
  externalTrainingRecords  ExternalTrainingRecord[]
  attestations             Attestation[]
  certificates             Certificate[]
  onboardings              EmployeeOnboarding[]
  policyAssignments        PolicyAssignment[]
  workReadinessEvaluations WorkReadinessEvaluation[]
  medicationQualifications MedicationQualification[]
  medicationInstructions   PersonSpecificMedicationInstruction[]
  medicationAuthorizations MedicationAuthorizationEvidence[]
  serviceAssignments       ServiceAssignment[]
  assignmentEvaluations    ServiceAssignmentEligibilityEvaluation[]
  complianceIssues         ComplianceIssue[]
  portalInvitations        EmployeePortalInvitation[]
  auditAccessScopes        AuditAccessEmployee[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, userId])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, lastName, firstName])
}

model RegulatoryAuthority {
  id           String       @id @default(cuid())
  jurisdiction String
  agency       String
  name         String
  sourceUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  regulations  Regulation[]

  @@unique([jurisdiction, agency, name])
}

model Regulation {
  id          String              @id @default(cuid())
  authorityId String
  citation    String
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  authority   RegulatoryAuthority @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  versions    RegulationVersion[]

  @@unique([authorityId, citation])
  @@index([citation])
}

model RegulationVersion {
  id                          String                        @id @default(cuid())
  regulationId                String
  effectiveFrom               DateTime                      @db.Date
  effectiveUntil              DateTime?                     @db.Date
  sourceUrl                   String
  sourceTextSnapshotObjectKey String?
  contentHash                 String?
  verificationStatus          VerificationStatus
  verifiedAt                  DateTime?
  verifiedByUserId            String?
  status                      RegulationVersionStatus       @default(DRAFT)
  createdAt                   DateTime                      @default(now())
  regulation                  Regulation                    @relation(fields: [regulationId], references: [id], onDelete: Restrict)
  verifiedBy                  User?                         @relation("RegulationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  authorityMappings           RequirementAuthorityMapping[]

  @@unique([regulationId, effectiveFrom])
  @@index([status, effectiveFrom, effectiveUntil])
}

model ComplianceRequirement {
  id                  String                         @id @default(cuid())
  code                String                         @unique
  name                String
  description         String?
  licenseType         LicenseType
  requirementCategory RequirementCategory
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  versions            ComplianceRequirementVersion[]
}

model ComplianceRequirementVersion {
  id                            String                             @id @default(cuid())
  requirementId                 String
  versionNumber                 Int
  effectiveFrom                 DateTime                           @db.Date
  effectiveUntil                DateTime?                          @db.Date
  verificationStatus            VerificationStatus
  status                        RequirementVersionStatus           @default(DRAFT)
