generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum LicenseType {
  MN_245D
  MN_144G
  MN_144A
  MN_245I
  OTHER
}

enum LicenseStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

enum RoleScope {
  ORGANIZATION
  PLATFORM
}

enum EmploymentStatus {
  PENDING
  ACTIVE
  LEAVE
  TERMINATED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  CONTRACTOR
  VOLUNTEER
  OTHER
}

enum ServiceEventType {
  HIRED
  FIRST_DIRECT_CONTACT
  FIRST_SUPERVISED_DIRECT_CONTACT
  FIRST_UNSUPERVISED_DIRECT_CONTACT
  ROLE_CHANGED
  MEDICATION_DUTY_ASSIGNED
}

enum RegulationVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum VerificationStatus {
  PRIMARY_SOURCE_VERIFIED
  PRIMARY_SOURCE_CLINICAL_GOVERNANCE
  DHS_GUIDANCE_VERIFIED
  ORGANIZATION_POLICY
  PENDING_REVIEW
}

enum RequirementCategory {
  WORKFORCE
  PERSON_SPECIFIC
  MEDICATION
  CLINICAL
  POSITIVE_SUPPORTS
  PERSONNEL_RECORD
  ORGANIZATION_POLICY
  OTHER
}

enum RequirementVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum BlockingScope {
  GENERAL_WORK
  DIRECT_CONTACT
  UNSUPERVISED_CONTACT
  PERSON_SPECIFIC_TASK
  MEDICATION_ADMINISTRATION
}

enum RequirementAuthorityRelationship {
  PRIMARY
  SUPPORTING
  EXCEPTION
}

enum RulesetStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum EvaluationScopeType {
  EMPLOYEE
  ORGANIZATION
}

enum ComplianceEvaluationTrigger {
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  ROLE_CHANGED
  DUTY_CHANGED
  SERVICE_EVENT_CREATED
  RULESET_CHANGED
  MANUAL
  RECONCILIATION
}

enum EvaluationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ComplianceTriggerType {
  EMPLOYEE_HIRED
  FIRST_DIRECT_CONTACT
  FIRST_UNSUPERVISED_DIRECT_CONTACT
  DUTY_ASSIGNED
  ROLE_ASSIGNED
  FIXED_REQUIREMENT
}

enum ComplianceStatus {
  REQUIRED
  ASSIGNED
  IN_PROGRESS
  SATISFIED
  WITHIN_LEGAL_DELAY
  PAST_DUE
  EXPIRED
  BLOCKED
  SUPERSEDED
  WAIVED_BY_EQUIVALENCY
}

enum TrainingCourseStatus {
  ACTIVE
  ARCHIVED
}

enum TrainingOwnershipType {
  PLATFORM
  ORGANIZATION
}

enum TrainingCourseVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  RETIRED
}

enum TrainingModuleType {
  CONTENT
  ASSESSMENT
  MIXED
}

enum TrainingContentType {
  RICH_TEXT
  WRITTEN
  VIDEO
  DOCUMENT_REFERENCE
  ACKNOWLEDGMENT
  ASSESSMENT
  EXTERNAL_RESOURCE
}

enum TrainingSatisfactionType {
  TRAINING_ONLY
  TRAINING_AND_COMPETENCY
  ALTERNATIVE
}

enum TrainingAssignmentSource {
  COMPLIANCE_ENGINE
  MANUAL
  ORGANIZATION_POLICY
  ADMINISTRATOR
}

enum TrainingProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  LOCKED
  SUPERSEDED
}

enum TrainingAssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  TRAINING_COMPLETE_COMPETENCY_PENDING
  FAILED
  SUPERSEDED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AssessmentQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum TrainingCompletionMethod {
  COURSEWORK
}

enum CompetencyMethod {
  KNOWLEDGE_TEST
  OBSERVED_SKILL
  SUPERVISOR_ATTESTATION
  TRAINER_ATTESTATION
  ORAL_COMPETENCY
  EXTERNAL_CREDENTIAL
  PRACTICAL_CHECKLIST
}

enum EvidenceOwnerType {
  PLATFORM
  ORGANIZATION
}

enum CompetencyDefinitionStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SkillChecklistVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum CompetencyAssessmentStatus {
  DRAFT
  IN_PROGRESS
  FINALIZED
  VOIDED
}

enum CompetencyAssessmentResult {
  PASS
  FAIL
  REMEDIATION_REQUIRED
  INCOMPLETE
}

enum CompetencyAssessmentItemResult {
  PASS
  FAIL
  NOT_OBSERVED
  NOT_APPLICABLE
}

enum ProfessionalCredentialType {
  RN
  CNS
  CNP
  PA
  PHYSICIAN
  CPR_INSTRUCTOR
  FIRST_AID_INSTRUCTOR
  OTHER
}

enum CredentialVerificationStatus {
  UNVERIFIED
  SELF_REPORTED
  DOCUMENT_REVIEWED
  VERIFIED
  EXPIRED
  REVOKED
}

enum ProfessionalCredentialStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ExternalTrainingReviewStatus {
  PENDING
  APPROVED
  DENIED
  NEEDS_MORE_INFORMATION
}

enum EquivalencyDecision {
  APPROVED
  DENIED
  NEEDS_MORE_INFORMATION
}

enum AttestationType {
  POLICY_ACKNOWLEDGMENT
  TRAINER_ATTESTATION
  SUPERVISOR_COMPETENCY
  EMPLOYEE_COMPLETION
  DOCUMENT_REVIEW
  OTHER
}

enum ComplianceEvidenceType {
  TRAINING_COMPLETION
  ASSESSMENT
  COMPETENCY_ASSESSMENT
  ATTESTATION
  EXTERNAL_TRAINING
  EXTERNAL_CREDENTIAL
  EQUIVALENCY_DECISION
}

enum EvidenceCorrectionType {
  SUPERSEDED
  VOIDED
  CORRECTED_BY_REPLACEMENT
  ADMINISTRATIVE_NOTE
}

enum CertificateType {
  TRAINING
  COMPETENCY
  COMPLIANCE
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
  EXPIRED
}

model Brand {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  status           RecordStatus   @default(ACTIVE)
  logoObjectKey    String?
  faviconObjectKey String?
  primaryDomain    String?
  supportEmail     String?
  themeConfigJson  Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organizations    Organization[]
}

model Organization {
  id                       String                           @id @default(cuid())
  brandId                  String?
  legalName                String
  displayName              String
  slug                     String                           @unique
  status                   OrganizationStatus               @default(ACTIVE)
  timezone                 String                           @default("America/Chicago")
  defaultLanguage          String?
  phone                    String?
  email                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  brand                    Brand?                           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  licenses                 OrganizationLicense[]
  programs                 Program[]
  locations                Location[]
  memberships              OrganizationMembership[]
  roles                    RoleDefinition[]
  employees                Employee[]
  serviceEvents            EmployeeServiceEvent[]
  complianceEvaluationRuns ComplianceEvaluationRun[]
  complianceInstances      ComplianceInstance[]
  trainingCourses          TrainingCourse[]
  trainingAssignments      TrainingAssignment[]
  trainingCompletions      TrainingCompletion[]
  assessmentAttempts       AssessmentAttempt[]
  competencyDefinitions    CompetencyDefinition[]
  skillChecklists          SkillChecklist[]
  competencyAssessments    CompetencyAssessment[]
  professionalCredentials  ProfessionalCredential[]
  externalTrainingRecords  ExternalTrainingRecord[]
  equivalencyDecisions     RequirementEquivalencyDecision[]
  attestations             Attestation[]
  evidenceCorrections      EvidenceCorrection[]
  certificates             Certificate[]
}

model OrganizationLicense {
  id               String        @id @default(cuid())
  organizationId   String
  licenseType      LicenseType
  licenseNumber    String?
  licenseStatus    LicenseStatus @default(PENDING)
  effectiveDate    DateTime?     @db.Date
  expirationDate   DateTime?     @db.Date
  issuingAuthority String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Program {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  code           String?
  programType    String?
  status         RecordStatus           @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations      Location[]
  serviceEvents  EmployeeServiceEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Location {
  id             String                 @id @default(cuid())
  organizationId String
  programId      String?
  name           String
  locationType   String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  status         RecordStatus           @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program        Program?               @relation(fields: [programId], references: [id], onDelete: SetNull)
  serviceEvents  EmployeeServiceEvent[]

  @@index([organizationId, status])
  @@index([organizationId, programId])
}

model User {
  id                         String                           @id @default(cuid())
  authProviderUserId         String?                          @unique
  email                      String?                          @unique
  phone                      String?
  status                     UserStatus                       @default(INVITED)
  lastLoginAt                DateTime?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  memberships                OrganizationMembership[]
  employees                  Employee[]
  recordedEvents             EmployeeServiceEvent[]           @relation("RecordedBy")
  verifiedRegulationVersions RegulationVersion[]              @relation("RegulationVerifiedBy")
  assignedTraining           TrainingAssignment[]             @relation("TrainingAssignedBy")
  trainingAcknowledgments    TrainingAcknowledgment[]         @relation("TrainingAcknowledgedBy")
  competencyAssessments      CompetencyAssessment[]           @relation("CompetencyAssessorUser")
  credentials                ProfessionalCredential[]         @relation("CredentialUser")
  verifiedCredentials        ProfessionalCredential[]         @relation("CredentialVerifiedBy")
  reviewedExternalTraining   ExternalTrainingRecord[]         @relation("ExternalTrainingReviewedBy")
  equivalencyDecisions       RequirementEquivalencyDecision[] @relation("EquivalencyReviewer")
  attestations               Attestation[]                    @relation("AttestationSigner")
  evidenceCorrections        EvidenceCorrection[]             @relation("EvidenceCorrectedBy")
  issuedCertificates         Certificate[]                    @relation("CertificateIssuedBy")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  endedAt        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RoleDefinition {
  id                 String           @id @default(cuid())
  organizationId     String?
  code               String
  name               String
  description        String?
  scope              RoleScope
  isPlatformStandard Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions        RolePermission[]
  memberships        MembershipRole[]
  employeeRoles      EmployeeRole[]

  @@unique([organizationId, code])
  @@index([code, isPlatformStandard])
}

model RolePermission {
  id               String         @id @default(cuid())
  roleDefinitionId String
  permissionId     String
  createdAt        DateTime       @default(now())
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleDefinitionId, permissionId])
}

model MembershipRole {
  id               String                 @id @default(cuid())
  membershipId     String
  roleDefinitionId String
  createdAt        DateTime               @default(now())
  membership       OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  roleDefinition   RoleDefinition         @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleDefinitionId])
}

model Employee {
  id                      String                   @id @default(cuid())
  organizationId          String
  userId                  String?
  employeeNumber          String?
  firstName               String
  middleName              String?
  lastName                String
  preferredName           String?
  email                   String?
  phone                   String?
  hireDate                DateTime?                @db.Date
  terminationDate         DateTime?                @db.Date
  employmentStatus        EmploymentStatus         @default(PENDING)
  jobTitle                String?
  employmentType          EmploymentType?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  roles                   EmployeeRole[]
  duties                  EmployeeDuty[]
  serviceEvents           EmployeeServiceEvent[]
  complianceInstances     ComplianceInstance[]
  trainingAssignments     TrainingAssignment[]
  trainingCompletions     TrainingCompletion[]
  assessmentAttempts      AssessmentAttempt[]
  trainingAcknowledgments TrainingAcknowledgment[]
  competencyAssessments   CompetencyAssessment[]   @relation("CompetencySubject")
  assessedCompetencies    CompetencyAssessment[]   @relation("CompetencyAssessorEmployee")
  professionalCredentials ProfessionalCredential[]
  externalTrainingRecords ExternalTrainingRecord[]
  attestations            Attestation[]
  certificates            Certificate[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, userId])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, lastName, firstName])
}

model RegulatoryAuthority {
  id           String       @id @default(cuid())
  jurisdiction String
  agency       String
  name         String
  sourceUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  regulations  Regulation[]

  @@unique([jurisdiction, agency, name])
}

model Regulation {
  id          String              @id @default(cuid())
  authorityId String
  citation    String
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  authority   RegulatoryAuthority @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  versions    RegulationVersion[]

  @@unique([authorityId, citation])
  @@index([citation])
}

model RegulationVersion {
  id                          String                        @id @default(cuid())
  regulationId                String
  effectiveFrom               DateTime                      @db.Date
  effectiveUntil              DateTime?                     @db.Date
  sourceUrl                   String
  sourceTextSnapshotObjectKey String?
  contentHash                 String?
  verificationStatus          VerificationStatus
  verifiedAt                  DateTime?
  verifiedByUserId            String?
  status                      RegulationVersionStatus       @default(DRAFT)
  createdAt                   DateTime                      @default(now())
  regulation                  Regulation                    @relation(fields: [regulationId], references: [id], onDelete: Restrict)
  verifiedBy                  User?                         @relation("RegulationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  authorityMappings           RequirementAuthorityMapping[]

  @@unique([regulationId, effectiveFrom])
  @@index([status, effectiveFrom, effectiveUntil])
}

model ComplianceRequirement {
  id                  String                         @id @default(cuid())
  code                String                         @unique
  name                String
  description         String?
  licenseType         LicenseType
  requirementCategory RequirementCategory
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  versions            ComplianceRequirementVersion[]
}

model ComplianceRequirementVersion {
  id                      String                           @id @default(cuid())
  requirementId           String
  versionNumber           Int
  effectiveFrom           DateTime                         @db.Date
  effectiveUntil          DateTime?                        @db.Date
  verificationStatus      VerificationStatus
  status                  RequirementVersionStatus         @default(DRAFT)
  applicabilityDefinition Json
  triggerDefinition       Json
  deadlineDefinition      Json
  recurrenceDefinition    Json?
  competencyDefinition    Json?
  evidenceDefinition      Json?
  legalGraceDefinition    Json?
  blockingScope           BlockingScope?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  requirement             ComplianceRequirement            @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  authorityMappings       RequirementAuthorityMapping[]
  rulesets                ComplianceRulesetRequirement[]
  complianceInstances     ComplianceInstance[]
  trainingOptions         RequirementTrainingOption[]
  competencyRequirements  CompetencyRequirement[]
  equivalencyDecisions    RequirementEquivalencyDecision[]

  @@unique([requirementId, versionNumber])
  @@index([status, effectiveFrom, effectiveUntil])
}

model RequirementAuthorityMapping {
  id                   String                           @id @default(cuid())
  requirementVersionId String
  regulationVersionId  String
  relationshipType     RequirementAuthorityRelationship
  citationNote         String?
  createdAt            DateTime                         @default(now())
  requirementVersion   ComplianceRequirementVersion     @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  regulationVersion    RegulationVersion                @relation(fields: [regulationVersionId], references: [id], onDelete: Restrict)

  @@unique([requirementVersionId, regulationVersionId, relationshipType])
}

model ComplianceRuleset {
  id                  String                         @id @default(cuid())
  licenseType         LicenseType
  version             Int
  effectiveFrom       DateTime                       @db.Date
  effectiveUntil      DateTime?                      @db.Date
  status              RulesetStatus                  @default(DRAFT)
  contentHash         String?
  approvedAt          DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  requirements        ComplianceRulesetRequirement[]
  evaluationRuns      ComplianceEvaluationRun[]
  complianceInstances ComplianceInstance[]

  @@unique([licenseType, version])
  @@index([status, effectiveFrom, effectiveUntil])
}

model ComplianceRulesetRequirement {
  id                   String                       @id @default(cuid())
  rulesetId            String
  requirementVersionId String
  createdAt            DateTime                     @default(now())
  ruleset              ComplianceRuleset            @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
  requirementVersion   ComplianceRequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)

  @@unique([rulesetId, requirementVersionId])
}

model ComplianceEvaluationRun {
  id                     String                      @id @default(cuid())
  organizationId         String
  scopeType              EvaluationScopeType
  scopeReference         String?
  rulesetId              String
  rulesetVersionSnapshot Int
  trigger                ComplianceEvaluationTrigger
  startedAt              DateTime                    @default(now())
  completedAt            DateTime?
  status                 EvaluationRunStatus         @default(PENDING)
  summaryJson            Json?
  createdAt              DateTime                    @default(now())
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ruleset                ComplianceRuleset           @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
  instances              ComplianceInstance[]

  @@index([organizationId, startedAt])
}

model ComplianceInstance {
  id                    String                       @id @default(cuid())
  fingerprint           String                       @unique
  organizationId        String
  employeeId            String
  requirementVersionId  String
  triggerType           ComplianceTriggerType
  triggerReference      String?
  requiredAt            DateTime
  nominalDueAt          DateTime?
  statutoryDelayUntil   DateTime?
  hardBlockAt           DateTime?
  status                ComplianceStatus
  satisfiedAt           DateTime?
  lastEvaluatedAt       DateTime
  rulesetId             String
  evaluationRunId       String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee              Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requirementVersion    ComplianceRequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  ruleset               ComplianceRuleset            @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
  evaluationRun         ComplianceEvaluationRun?     @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)
  evidence              ComplianceInstanceEvidence[]
  trainingAssignments   TrainingAssignment[]
  competencyAssessments CompetencyAssessment[]

  @@index([organizationId, employeeId, status])
  @@index([requirementVersionId])
}

model ComplianceInstanceEvidence {
  id                   String                 @id @default(cuid())
  complianceInstanceId String
  evidenceType         ComplianceEvidenceType
  evidenceReferenceId  String
  createdAt            DateTime               @default(now())
  complianceInstance   ComplianceInstance     @relation(fields: [complianceInstanceId], references: [id], onDelete: Restrict)

  @@unique([complianceInstanceId, evidenceType, evidenceReferenceId])
}

model EmployeeRole {
  id               String         @id @default(cuid())
  employeeId       String
  roleDefinitionId String
  effectiveFrom    DateTime       @db.Date
  effectiveUntil   DateTime?      @db.Date
  createdAt        DateTime       @default(now())
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveUntil])
}

model DutyDefinition {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  description    String?
  createdAt      DateTime       @default(now())
  employeeDuties EmployeeDuty[]
}

model EmployeeDuty {
  id               String         @id @default(cuid())
  employeeId       String
  dutyDefinitionId String
  effectiveFrom    DateTime       @db.Date
  effectiveUntil   DateTime?      @db.Date
  source           String?
  createdAt        DateTime       @default(now())
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  dutyDefinition   DutyDefinition @relation(fields: [dutyDefinitionId], references: [id], onDelete: Restrict)

  @@unique([employeeId, dutyDefinitionId, effectiveFrom])
  @@index([employeeId, effectiveUntil])
}

model EmployeeServiceEvent {
  id               String           @id @default(cuid())
  organizationId   String
  employeeId       String
  eventType        ServiceEventType
  occurredAt       DateTime
  programId        String?
  locationId       String?
  recordedByUserId String?
  notes            String?
  createdAt        DateTime         @default(now())
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  program          Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  location         Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recordedBy       User?            @relation("RecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, occurredAt])
}

model TrainingCourse {
  id             String                  @id @default(cuid())
  organizationId String?
  catalogKey     String                  @unique
  code           String
  title          String
  description    String?
  category       String
  status         TrainingCourseStatus    @default(ACTIVE)
  ownershipType  TrainingOwnershipType
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions       TrainingCourseVersion[]
  completions    TrainingCompletion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model TrainingCourseVersion {
  id                       String                      @id @default(cuid())
  courseId                 String
  versionNumber            Int
  status                   TrainingCourseVersionStatus @default(DRAFT)
  effectiveFrom            DateTime                    @db.Date
  effectiveUntil           DateTime?                   @db.Date
  publishedAt              DateTime?
  estimatedDurationMinutes Int?
  contentHash              String
  createdAt                DateTime                    @default(now())
  course                   TrainingCourse              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  modules                  TrainingModule[]
  trainingOptions          RequirementTrainingOption[]
  assignments              TrainingAssignment[]
  completions              TrainingCompletion[]

  @@unique([courseId, versionNumber])
  @@index([status, effectiveFrom, effectiveUntil])
}

model TrainingModule {
  id                       String                   @id @default(cuid())
  courseVersionId          String
  sequence                 Int
  title                    String
  moduleType               TrainingModuleType
  required                 Boolean                  @default(true)
  estimatedDurationMinutes Int?
  createdAt                DateTime                 @default(now())
  courseVersion            TrainingCourseVersion    @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  contentItems             TrainingContentItem[]
  assessments              Assessment[]
  progress                 TrainingModuleProgress[]

  @@unique([courseVersionId, sequence])
}

model TrainingContentItem {
  id              String                    @id @default(cuid())
  moduleId        String
  sequence        Int
  contentType     TrainingContentType
  payload         Json
  required        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  module          TrainingModule            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  progress        TrainingContentProgress[]
  acknowledgments TrainingAcknowledgment[]

  @@unique([moduleId, sequence])
}

model RequirementTrainingOption {
  id                             String                       @id @default(cuid())
  complianceRequirementVersionId String
  trainingCourseVersionId        String
  satisfactionType               TrainingSatisfactionType
  isDefault                      Boolean                      @default(false)
  effectiveFrom                  DateTime?                    @db.Date
  effectiveUntil                 DateTime?                    @db.Date
  conditions                     Json?
  createdAt                      DateTime                     @default(now())
  complianceRequirementVersion   ComplianceRequirementVersion @relation(fields: [complianceRequirementVersionId], references: [id], onDelete: Restrict)
  trainingCourseVersion          TrainingCourseVersion        @relation(fields: [trainingCourseVersionId], references: [id], onDelete: Restrict)

  @@unique([complianceRequirementVersionId, trainingCourseVersionId])
  @@index([complianceRequirementVersionId, isDefault])
}

model TrainingAssignment {
  id                    String                    @id @default(cuid())
  fingerprint           String                    @unique
  organizationId        String
  employeeId            String
  courseVersionId       String
  sourceType            TrainingAssignmentSource
  sourceReferenceId     String?
  complianceInstanceId  String?
  assignedAt            DateTime                  @default(now())
  dueAt                 DateTime?
  status                TrainingAssignmentStatus  @default(NOT_STARTED)
  assignedByUserId      String?
  startedAt             DateTime?
  completedAt           DateTime?
  supersededAt          DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee              Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  courseVersion         TrainingCourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  complianceInstance    ComplianceInstance?       @relation(fields: [complianceInstanceId], references: [id], onDelete: Restrict)
  assignedBy            User?                     @relation("TrainingAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  moduleProgress        TrainingModuleProgress[]
  contentProgress       TrainingContentProgress[]
  acknowledgments       TrainingAcknowledgment[]
  attempts              AssessmentAttempt[]
  completion            TrainingCompletion?
  competencyAssessments CompetencyAssessment[]

  @@index([organizationId, employeeId, status])
  @@index([complianceInstanceId])
}

model TrainingModuleProgress {
  id           String                 @id @default(cuid())
  assignmentId String
  moduleId     String
  status       TrainingProgressStatus @default(NOT_STARTED)
  startedAt    DateTime?
  completedAt  DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  assignment   TrainingAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  module       TrainingModule         @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, moduleId])
}

model TrainingContentProgress {
  id            String                 @id @default(cuid())
  assignmentId  String
  contentItemId String
  status        TrainingProgressStatus @default(NOT_STARTED)
  startedAt     DateTime?
  completedAt   DateTime?
  lastViewedAt  DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  assignment    TrainingAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  contentItem   TrainingContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, contentItemId])
}

model TrainingAcknowledgment {
  id                   String              @id @default(cuid())
  assignmentId         String
  contentItemId        String
  employeeId           String
  acknowledgedByUserId String
  acknowledgedAt       DateTime            @default(now())
  createdAt            DateTime            @default(now())
  assignment           TrainingAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  contentItem          TrainingContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  acknowledgedBy       User                @relation("TrainingAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, contentItemId])
  @@index([employeeId])
}

model Assessment {
  id                 String               @id @default(cuid())
  moduleId           String
  versionNumber      Int
  title              String
  passingScore       Decimal              @db.Decimal(5, 2)
  maxAttempts        Int?
  randomizeQuestions Boolean              @default(false)
  status             AssessmentStatus     @default(DRAFT)
  createdAt          DateTime             @default(now())
  module             TrainingModule       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  questions          AssessmentQuestion[]
  attempts           AssessmentAttempt[]

  @@unique([moduleId, versionNumber])
}

model AssessmentQuestion {
  id           String                 @id @default(cuid())
  assessmentId String
  questionType AssessmentQuestionType
  prompt       String
  explanation  String?
  sequence     Int
  points       Decimal                @db.Decimal(8, 2)
  required     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  options      AssessmentOption[]
  responses    AssessmentResponse[]

  @@unique([assessmentId, sequence])
}

model AssessmentOption {
  id         String             @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean
  sequence   Int
  createdAt  DateTime           @default(now())
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([questionId, sequence])
}

model AssessmentAttempt {
  id                   String               @id @default(cuid())
  organizationId       String
  employeeId           String
  trainingAssignmentId String
  assessmentId         String
  attemptNumber        Int
  startedAt            DateTime             @default(now())
  submittedAt          DateTime?
  score                Decimal?             @db.Decimal(8, 2)
  maxScore             Decimal?             @db.Decimal(8, 2)
  percentage           Decimal?             @db.Decimal(5, 2)
  passed               Boolean?
  resultSnapshot       Json?
  createdAt            DateTime             @default(now())
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee             Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  trainingAssignment   TrainingAssignment   @relation(fields: [trainingAssignmentId], references: [id], onDelete: Restrict)
  assessment           Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  responses            AssessmentResponse[]
  completions          TrainingCompletion[]

  @@unique([trainingAssignmentId, assessmentId, attemptNumber])
  @@index([organizationId, employeeId])
}

model AssessmentResponse {
  id                String             @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionIds Json
  awardedPoints     Decimal            @db.Decimal(8, 2)
  correct           Boolean
  resultSnapshot    Json
  createdAt         DateTime           @default(now())
  attempt           AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question          AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
}

model TrainingCompletion {
  id                       String                    @id @default(cuid())
  organizationId           String
  employeeId               String
  assignmentId             String                    @unique
  courseId                 String
  courseVersionId          String
  completedAt              DateTime
  completionMethod         TrainingCompletionMethod
  finalAssessmentAttemptId String?
  evidenceSnapshotJson     Json
  contentHash              String
  createdAt                DateTime                  @default(now())
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                 Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignment               TrainingAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  course                   TrainingCourse            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseVersion            TrainingCourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  finalAssessmentAttempt   AssessmentAttempt?        @relation(fields: [finalAssessmentAttemptId], references: [id], onDelete: SetNull)
  subjectEvidence          TrainingSubjectEvidence[]
  certificates             Certificate[]

  @@index([organizationId, employeeId, completedAt])
}

model CompetencyDefinition {
  id             String                     @id @default(cuid())
  code           String
  name           String
  description    String?
  method         CompetencyMethod
  ownerType      EvidenceOwnerType
  organizationId String?
  status         CompetencyDefinitionStatus @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requirements   CompetencyRequirement[]
  assessments    CompetencyAssessment[]

  @@unique([organizationId, code])
  @@index([code, ownerType])
}

model CompetencyRequirement {
  id                     String                       @id @default(cuid())
  requirementVersionId   String
  competencyDefinitionId String
  required               Boolean                      @default(true)
  sequence               Int?
  createdAt              DateTime                     @default(now())
  requirementVersion     ComplianceRequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  competencyDefinition   CompetencyDefinition         @relation(fields: [competencyDefinitionId], references: [id], onDelete: Restrict)

  @@unique([requirementVersionId, competencyDefinitionId])
}

model SkillChecklist {
  id             String                     @id @default(cuid())
  code           String
  name           String
  description    String?
  ownerType      EvidenceOwnerType
  organizationId String?
  status         CompetencyDefinitionStatus @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions       SkillChecklistVersion[]

  @@unique([organizationId, code])
  @@index([code, ownerType])
}

model SkillChecklistVersion {
  id               String                      @id @default(cuid())
  skillChecklistId String
  versionNumber    Int
  status           SkillChecklistVersionStatus @default(DRAFT)
  effectiveFrom    DateTime?                   @db.Date
  effectiveUntil   DateTime?                   @db.Date
  contentHash      String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  skillChecklist   SkillChecklist              @relation(fields: [skillChecklistId], references: [id], onDelete: Restrict)
  items            SkillChecklistItem[]
  assessments      CompetencyAssessment[]

  @@unique([skillChecklistId, versionNumber])
}

model SkillChecklistItem {
  id                      String                     @id @default(cuid())
  skillChecklistVersionId String
  sequence                Int
  code                    String?
  description             String
  required                Boolean                    @default(true)
  criticalFailure         Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  skillChecklistVersion   SkillChecklistVersion      @relation(fields: [skillChecklistVersionId], references: [id], onDelete: Restrict)
  assessmentItems         CompetencyAssessmentItem[]

  @@unique([skillChecklistVersionId, sequence])
}

model CompetencyAssessment {
  id                            String                      @id @default(cuid())
  organizationId                String
  employeeId                    String
  competencyDefinitionId        String
  skillChecklistVersionId       String?
  trainingAssignmentId          String?
  complianceInstanceId          String?
  assessorUserId                String
  assessorEmployeeId            String?
  assessorNameSnapshot          String
  assessorQualificationSnapshot Json?
  status                        CompetencyAssessmentStatus  @default(DRAFT)
  result                        CompetencyAssessmentResult?
  startedAt                     DateTime                    @default(now())
  completedAt                   DateTime?
  notes                         String?
  finalizedAt                   DateTime?
  createdAt                     DateTime                    @default(now())
  organization                  Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                      Employee                    @relation("CompetencySubject", fields: [employeeId], references: [id], onDelete: Restrict)
  competencyDefinition          CompetencyDefinition        @relation(fields: [competencyDefinitionId], references: [id], onDelete: Restrict)
  skillChecklistVersion         SkillChecklistVersion?      @relation(fields: [skillChecklistVersionId], references: [id], onDelete: Restrict)
  trainingAssignment            TrainingAssignment?         @relation(fields: [trainingAssignmentId], references: [id], onDelete: Restrict)
  complianceInstance            ComplianceInstance?         @relation(fields: [complianceInstanceId], references: [id], onDelete: Restrict)
  assessorUser                  User                        @relation("CompetencyAssessorUser", fields: [assessorUserId], references: [id], onDelete: Restrict)
  assessorEmployee              Employee?                   @relation("CompetencyAssessorEmployee", fields: [assessorEmployeeId], references: [id], onDelete: SetNull)
  items                         CompetencyAssessmentItem[]
  certificates                  Certificate[]

  @@index([organizationId, employeeId, status])
}

model CompetencyAssessmentItem {
  id                     String                         @id @default(cuid())
  competencyAssessmentId String
  skillChecklistItemId   String
  result                 CompetencyAssessmentItemResult
  notes                  String?
  evaluatedAt            DateTime                       @default(now())
  createdAt              DateTime                       @default(now())
  competencyAssessment   CompetencyAssessment           @relation(fields: [competencyAssessmentId], references: [id], onDelete: Restrict)
  skillChecklistItem     SkillChecklistItem             @relation(fields: [skillChecklistItemId], references: [id], onDelete: Restrict)

  @@unique([competencyAssessmentId, skillChecklistItemId])
}

model ProfessionalCredential {
  id                 String                       @id @default(cuid())
  organizationId     String
  employeeId         String?
  userId             String?
  credentialType     ProfessionalCredentialType
  credentialName     String?
  licenseNumber      String?
  jurisdiction       String?
  issuedAt           DateTime?                    @db.Date
  expiresAt          DateTime?                    @db.Date
  verificationStatus CredentialVerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedByUserId   String?
  evidenceReference  String?
  status             ProfessionalCredentialStatus @default(ACTIVE)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee           Employee?                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user               User?                        @relation("CredentialUser", fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy         User?                        @relation("CredentialVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
}

model ExternalTrainingRecord {
  id                   String                           @id @default(cuid())
  organizationId       String
  employeeId           String
  providerName         String
  trainingName         String
  trainingDate         DateTime                         @db.Date
  trainingMinutes      Int?
  credentialNumber     String?
  expiresAt            DateTime?                        @db.Date
  evidenceReference    String?
  reviewStatus         ExternalTrainingReviewStatus     @default(PENDING)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  notes                String?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  organization         Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee             Employee                         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewedBy           User?                            @relation("ExternalTrainingReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  equivalencyDecisions RequirementEquivalencyDecision[]

  @@index([organizationId, employeeId])
}

model RequirementEquivalencyDecision {
  id                       String                       @id @default(cuid())
  organizationId           String
  externalTrainingRecordId String
  requirementVersionId     String
  decision                 EquivalencyDecision
  competencyVerified       Boolean                      @default(false)
  reviewerUserId           String
  decidedAt                DateTime                     @default(now())
  reason                   String
  createdAt                DateTime                     @default(now())
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  externalTrainingRecord   ExternalTrainingRecord       @relation(fields: [externalTrainingRecordId], references: [id], onDelete: Restrict)
  requirementVersion       ComplianceRequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  reviewer                 User                         @relation("EquivalencyReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, requirementVersionId])
}

model Attestation {
  id                String          @id @default(cuid())
  organizationId    String
  attestationType   AttestationType
  signerUserId      String
  signerEmployeeId  String?
  typedName         String
  statementVersion  String
  statementSnapshot String
  resourceType      String
  resourceId        String
  resourceVersionId String?
  signedAt          DateTime
  ipAddress         String?
  userAgent         String?
  sessionReference  String?
  signatureHash     String
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  signer            User            @relation("AttestationSigner", fields: [signerUserId], references: [id], onDelete: Restrict)
  signerEmployee    Employee?       @relation(fields: [signerEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId])
}

model TrainingSubjectEvidence {
  id                   String             @id @default(cuid())
  organizationId       String
  trainingCompletionId String
  subjectAreaCode      String
  subjectAreaName      String?
  minutes              Int
  createdAt            DateTime           @default(now())
  trainingCompletion   TrainingCompletion @relation(fields: [trainingCompletionId], references: [id], onDelete: Restrict)

  @@unique([trainingCompletionId, subjectAreaCode])
  @@index([organizationId])
}

model EvidenceCorrection {
  id                      String                 @id @default(cuid())
  organizationId          String
  resourceType            String
  resourceId              String
  correctionType          EvidenceCorrectionType
  reason                  String
  correctedByUserId       String
  replacementResourceType String?
  replacementResourceId   String?
  createdAt               DateTime               @default(now())
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  correctedBy             User                   @relation("EvidenceCorrectedBy", fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, resourceType, resourceId])
}

model Certificate {
  id                      String                @id @default(cuid())
  organizationId          String
  employeeId              String
  certificateType         CertificateType
  certificateNumber       String                @unique
  courseVersionId         String?
  trainingCompletionId    String?
  competencyAssessmentId  String?
  issuedAt                DateTime              @default(now())
  expiresAt               DateTime?
  verificationToken       String                @unique
  status                  CertificateStatus     @default(ACTIVE)
  certificateSnapshotJson Json
  issuedByUserId          String?
  createdAt               DateTime              @default(now())
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  trainingCompletion      TrainingCompletion?   @relation(fields: [trainingCompletionId], references: [id], onDelete: Restrict)
  competencyAssessment    CompetencyAssessment? @relation(fields: [competencyAssessmentId], references: [id], onDelete: Restrict)
  issuedBy                User?                 @relation("CertificateIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([trainingCompletionId, certificateType])
  @@index([organizationId, employeeId, status])
}
