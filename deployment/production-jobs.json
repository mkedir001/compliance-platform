{
  "version": 1,
  "jobs": [
    {
      "name": "organization-compliance-reconciliation",
      "schedule": "*/15 * * * *",
      "method": "POST",
      "path": "/api/jobs/compliance",
      "authorization": "Bearer ${JOB_SECRET}",
      "jsonBody": {
        "organizationId": "${PRODUCTION_ORGANIZATION_ID}"
      },
      "timeoutSeconds": 120,
      "maxConcurrentRuns": 1,
      "retryAttempts": 2
    },
    {
      "name": "axiscare-sync",
      "schedule": "*/15 * * * *",
      "method": "POST",
      "path": "/api/jobs/axiscare-sync",
      "authorization": "Bearer ${JOB_SECRET}",
      "timeoutSeconds": 300,
      "maxConcurrentRuns": 1,
      "retryAttempts": 1
    }
  ]
}
