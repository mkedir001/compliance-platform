DATABASE_URL="postgresql://postgres:postgres@localhost:55432/compliance_platform?schema=public"
# Development-only identity header used by the minimal verification UI/API.
DEV_USER_ID=""
COMPLIANCE_EXPIRING_SOON_DAYS="30"

# Production-only requirements (placeholders; never commit real values).
APP_BASE_URL="https://compliance.example.invalid"
PRODUCTION_AUTH_MODE="aws-alb-cognito"
# Required only for PRODUCTION_AUTH_MODE="trusted-proxy-hmac".
AUTH_PROXY_SECRET="replace-with-at-least-32-random-characters"
AWS_ALB_AUTH_SIGNER_ARN="arn:aws:elasticloadbalancing:us-east-2:000000000000:loadbalancer/app/example/0000000000000000"
AWS_ALB_AUTH_ISSUER="https://cognito-idp.us-east-2.amazonaws.com/us-east-2_example"
AWS_ALB_AUTH_CLIENT_ID="replace-with-cognito-app-client-id"
JOB_SECRET="replace-with-at-least-32-random-characters"
JOB_ACTOR_USER_ID="production-service-actor-user-id"
RATE_LIMIT_URL="https://rate-limit.example.invalid/check"
RATE_LIMIT_TOKEN="replace-with-a-durable-rate-limit-service-token"
EVIDENCE_STORAGE_MODE="external-reference"
EVIDENCE_STORAGE_URL="https://evidence-gateway.example.invalid/v1/evidence"
EVIDENCE_STORAGE_TOKEN="replace-with-a-private-evidence-gateway-token"

# Production transactional email. Amazon SES uses the ECS task role through the AWS SDK default
# credential chain; do not configure static AWS access keys or SES SMTP credentials.
EMAIL_PROVIDER="ses"
AWS_REGION="us-east-2"
# Required only for EMAIL_PROVIDER="paubox". The application invokes this
# function with its ECS task role and never receives the Paubox credential.
PAUBOX_RELAY_FUNCTION_NAME=""
MAILGUN_RELAY_FUNCTION_NAME=""
MAILGUN_FROM=""
MAILGUN_FROM_NAME="Compliance Platform"
MAILGUN_REPLY_TO=""
EMAIL_FROM="no-reply@example.invalid"
EMAIL_FROM_NAME="Compliance Platform"
EMAIL_REPLY_TO="support@example.invalid"

# Legacy provider-boundary option. Use only when EMAIL_PROVIDER="http"; SES does not use these.
EMAIL_API_URL=""
EMAIL_API_TOKEN=""

# Workforce/account email is purpose-routed to Mailgun and never falls back to Paubox.
WORKFORCE_EMAIL_PROVIDER=""
WORKFORCE_EMAIL_FROM=""
WORKFORCE_EMAIL_FROM_NAME="Compliance Platform"
WORKFORCE_EMAIL_REPLY_TO=""
WORKFORCE_EMAIL_API_URL=""
WORKFORCE_EMAIL_API_TOKEN=""

# Native electronic signatures. Production uses APP_BASE_URL for public links, rejects test delivery,
# and fails closed when SIGNING_DELIVERY_MODE=email lacks a complete email provider configuration.
SIGNING_DELIVERY_MODE="email"
# Development/test-only override; production always uses APP_BASE_URL.
SIGNING_PUBLIC_BASE_URL="http://localhost:3000"
SIGNING_INVITATION_LIFETIME_HOURS="72"
