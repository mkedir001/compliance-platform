# REQUIRED — application and database
NODE_ENV="production"
APP_BASE_URL="https://compliance.example.invalid"
DB_HOST="production-database.example.invalid"
DB_PORT="5432"
DB_NAME="compliance_platform"
DB_SSL_MODE="require"
# Inject both values directly from the RDS-managed secret with native ECS secret injection.
# Never copy them, or a constructed DATABASE_URL, into this file or the application secret.
DB_USERNAME="<ECS_RDS_SECRET_USERNAME>"
DB_PASSWORD="<ECS_RDS_SECRET_PASSWORD>"

# REQUIRED — trusted identity proxy (server-side only)
AUTH_PROXY_SECRET="replace-with-at-least-32-random-characters"

# REQUIRED — distributed rate-limit gateway
RATE_LIMIT_URL="https://rate-limit.example.invalid/check"
RATE_LIMIT_TOKEN="replace-with-a-durable-rate-limit-service-token"

# REQUIRED — private durable evidence gateway
EVIDENCE_STORAGE_MODE="external-reference"
EVIDENCE_STORAGE_URL="https://evidence-gateway.example.invalid/v1/evidence"
EVIDENCE_STORAGE_TOKEN="replace-with-a-private-evidence-gateway-token"

# REQUIRED — authenticated scheduled jobs
JOB_SECRET="replace-with-at-least-32-random-characters"
JOB_ACTOR_USER_ID="production-service-actor-user-id"

# CONDITIONALLY REQUIRED — SES remains supported; Paubox uses IAM Lambda invoke.
EMAIL_PROVIDER="paubox"
EMAIL_FROM="signatures@email.waldah.com"
EMAIL_FROM_NAME="Compliance Platform"
EMAIL_REPLY_TO=""
AWS_REGION="us-east-2"
PAUBOX_RELAY_FUNCTION_NAME="compliance-platform-prod-paubox-relay"
MAILGUN_RELAY_FUNCTION_NAME="compliance-platform-prod-mailgun-relay"
MAILGUN_FROM="notifications@mail.example.invalid"
MAILGUN_FROM_NAME="Compliance Platform"
MAILGUN_REPLY_TO=""
MAILGUN_WEBHOOK_SIGNING_KEY="set-from-dedicated-secrets-manager-secret"
# Legacy HTTP provider only. Never place the Paubox credential here.
EMAIL_API_URL=""
EMAIL_API_TOKEN=""

# REQUIRED FOR WORKFORCE DELIVERY — purpose-routed to the private Mailgun relay.
WORKFORCE_EMAIL_PROVIDER="mailgun"
WORKFORCE_EMAIL_FROM="notifications@mail.example.invalid"
WORKFORCE_EMAIL_FROM_NAME="Compliance Platform"
WORKFORCE_EMAIL_REPLY_TO=""
WORKFORCE_EMAIL_API_URL=""
WORKFORCE_EMAIL_API_TOKEN=""

# Native signing links. Email mode fails closed until the outbound adapter is configured.
SIGNING_DELIVERY_MODE="email"
SIGNING_PUBLIC_BASE_URL="https://compliance.example.invalid"
SIGNING_INVITATION_LIFETIME_HOURS="72"

# OPTIONAL — compliance warning horizon; structured logs go to stdout/stderr
COMPLIANCE_EXPIRING_SOON_DAYS="30"
